# Copy this file to .env on the Linux server. Do not commit the real .env file.
# Generate different long values for VACAY_DB_PASSWORD and JWT_KEY.
VACAY_DB_NAME=vacay
VACAY_DB_USER=vacay
VACAY_DB_PASSWORD=replace-with-a-long-random-database-password
JWT_KEY=replace-with-a-long-random-jwt-signing-key-at-least-32-characters

# These are the real Brevo credentials already used for verification, password-reset,
# reservation, rental, and cancellation emails.
BREVO_API_KEY=put-your-real-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-gmail-address@example.com
